# Dependencies
node_modules/
*/node_modules/
backend/node_modules/
frontend/node_modules/
clipslice/backend/node_modules/
clipslice/frontend/node_modules/

# Build artifacts
backend/dist/
clipslice/backend/dist/
# Allow pre-built frontend dist and cut for instant, error-free Vercel and cloud deployments
!dist/
!dist/**
!cut/
!cut/**
!clipslice/frontend/dist/
!clipslice/frontend/dist/**

# Temporary video processing clips and parts
temp/
*/temp/
backend/temp/
clipslice/backend/temp/
*.part
*.ytdl

# Environment & local files
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS metadata
.DS_Store
Thumbs.db
desktop.ini

# IDE & Editor caches
.vscode/
.idea/
.claude/
